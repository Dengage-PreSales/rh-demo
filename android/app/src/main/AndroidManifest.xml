<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push on Android 13 and later is a runtime permission. The debug screen
         carries the prompt so it is asked in context rather than cold. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Geofencing needs fine location while in use and background location
         granted as "Allow all the time". The OS forces a two step flow and the
         debug screen walks it in that order. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".DemoApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DengageDemo"
        android:usesCleartextTraffic="false"
        android:allowBackup="false">

        <!-- No den_*_api_url meta-data on purpose: account 28 lives on the
             default Dengage cluster, the same one the web storefront reaches
             through pcdn.dengage.com, so the SDK's default endpoints are the
             right ones. The overrides exist for customers whose support team
             hands them datacenter specific URLs. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- rhdemo://store/<id> is the deeplink a geofence push carries, so
                 tapping the notification lands the shopper on the storefront
                 already scoped to the shop they just walked past. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rhdemo" android:host="store" />
            </intent-filter>
        </activity>

        <activity android:name=".ProductActivity" android:exported="false" />
        <activity android:name=".InboxActivity" android:exported="false" />
        <activity android:name=".DebugActivity" android:exported="false" />

        <!-- Dengage's Firebase service handles both marketing pushes and the
             silent pushes the geofence module rides on. -->
        <service
            android:name="com.dengage.sdk.push.FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
