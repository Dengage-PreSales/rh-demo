<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/header"
        app:title="@string/app_name"
        app:titleTextColor="@color/on_header" />

    <TextView
        android:id="@+id/config_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warn_bg"
        android:padding="12dp"
        android:text="@string/config_warning"
        android:textColor="@color/on_cta"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/store_chip"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/store_unresolved" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/product_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false" />
</LinearLayout>
